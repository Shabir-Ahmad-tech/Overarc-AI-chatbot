# =============================================================================
# Overarc SmartBot — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit the actual .env file to version control.
# =============================================================================

# -------------------------------------------------------
# OpenRouter API Key
# Get yours at: https://openrouter.ai/settings/keys
# Used for: AI chat completions + embeddings
# -------------------------------------------------------
OPENROUTER_API_KEY=your_openrouter_api_key_here

# -------------------------------------------------------
# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
# Used for: PostgreSQL database + pgvector RAG storage
# If left empty, the app falls back to local JSON files
# -------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-public-key

# -------------------------------------------------------
# Resend Email API
# Get yours at: https://resend.com/api-keys
# Used for: Lead capture email notifications to business owners
# If left empty, email notifications are disabled
# -------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key_here

# -------------------------------------------------------
# JWT Secret Key
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Must be at least 32 characters. Keep this secret!
# -------------------------------------------------------
JWT_SECRET=your_random_32_byte_hex_secret_here

# -------------------------------------------------------
# Super Admin Key
# Generate with: python -c "import secrets; print(secrets.token_hex(24))"
# Used to protect /api/admin/create-client and /api/admin/set-status
# Only you should know this key.
# -------------------------------------------------------
SUPER_ADMIN_KEY=your_super_admin_key_here

# -------------------------------------------------------
# Admin Password (Legacy fallback)
# Simple password for the legacy /api/auth/check endpoint
# For new deployments, prefer using JWT + bcrypt passwords per bot
# -------------------------------------------------------
ADMIN_PASSWORD=change_me_to_a_strong_password

# -------------------------------------------------------
# Embedding Model (Optional — has a default)
# Default: perplexity/pplx-embed-v1-0.6b via OpenRouter
# -------------------------------------------------------
# EMBEDDING_MODEL=perplexity/pplx-embed-v1-0.6b

# -------------------------------------------------------
# PORT (Set automatically by Render / Heroku / Railway)
# Do NOT set this manually. It is injected by the platform.
# -------------------------------------------------------
# PORT=5000
